{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "https://github.com/konflux-ci/mintmaker/blob/main/config/renovate/renovate.json?raw=true"
    ],
    "dockerfile": {
        "includePaths": [
            "Dockerfile.monitor"
        ]
    },
    "github-actions": {
        "enabled": false
    },
    "gomod": {
        "enabled": false
    },
    "cargo": {
        "enabled": false
    },
    "pep621": {
        "enabled": false
    },
    "pip-compile": {
        "enabled": false
    },
    "pip_requirements": {
        "enabled": false
    },
    "pip_setup": {
        "enabled": false
    },
    "pipenv": {
        "enabled": false
    },
    "poetry": {
        "enabled": false
    },
    "pyenv": {
        "enabled": false
    },
    "runtime-version": {
        "enabled": false
    },
    "setup-cfg": {
        "enabled": false
    },
    "pep723": {
        "enabled": false
    }
}
